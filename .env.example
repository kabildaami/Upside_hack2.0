# Copy your existing local PostgreSQL credentials here. Never commit .env.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=Astrafenix_AI
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password
DB_SSLMODE=prefer
SQL_ECHO=false
JWT_SECRET=replace_with_a_random_value_at_least_32_characters
FRONTEND_ORIGIN=http://localhost:5173
ACCESS_TOKEN_MINUTES=30

# Choose an OpenRouter model that supports chat completions (and preferably structured JSON)
OPENROUTER_API_KEY=replace_with_your_openrouter_key
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional LangSmith (server side only)
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=EduNova-Agent
# LANGSMITH_API_KEY=your_key_here
